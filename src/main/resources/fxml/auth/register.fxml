<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="gui.controller.auth.RegisterController"
           prefWidth="1050"
           prefHeight="650"
           styleClass="register-root"
           stylesheets="@../../css/style.css">

    <children>

        <ImageView fx:id="background" preserveRatio="false">
            <image>
                <Image url="@../../images/register.png"/>
            </image>
        </ImageView>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    maxWidth="650"
                    styleClass="register-scroll"
                    StackPane.alignment="CENTER_RIGHT">

            <content>
                <VBox alignment="CENTER"
                      spacing="15"
                      maxWidth="650">

                    <padding>
                        <Insets top="25" right="25"
                                bottom="25" left="25"/>
                    </padding>

                    <ImageView fitWidth="150" preserveRatio="true">
                        <image>
                            <Image url="@../../images/hotel-logo.png"/>
                        </image>
                    </ImageView>

                    <VBox alignment="CENTER"
                          spacing="18"
                          maxWidth="550"
                          styleClass="register-card">

                        <Label text="Create a New Account"
                               styleClass="register-title"/>

                        <GridPane hgap="15" vgap="13">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <!-- First name -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="0">
                                <Label fx:id="firstNameError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="firstName"
                                           promptText="First Name"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- Last name -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="0">
                                <Label fx:id="lastNameError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="lastName"
                                           promptText="Last Name"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- Email -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="1">
                                <Label fx:id="emailError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="email"
                                           promptText="Email"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- Phone -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1">
                                <Label fx:id="phoneError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="phone"
                                           promptText="Phone Number"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- National ID -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="2">
                                <Label fx:id="nationalIdError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="nationalId"
                                           promptText="National ID (14 digits)"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- Birth date -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="2">
                                <Label fx:id="birthDateError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <DatePicker fx:id="birthDate"
                                            promptText="Date of Birth"
                                            maxWidth="Infinity"
                                            styleClass="register-field"/>
                            </VBox>

                            <!-- Nationality -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="3">
                                <Label fx:id="nationalityError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <TextField fx:id="nationality"
                                           promptText="Nationality"
                                           maxWidth="Infinity"
                                           styleClass="register-field"/>
                            </VBox>

                            <!-- Gender -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="3">
                                <Label fx:id="genderError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <ComboBox fx:id="gender"
                                          promptText="Gender"
                                          maxWidth="Infinity"
                                          styleClass="register-field"/>
                            </VBox>

                            <!-- Password -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="0"
                                  GridPane.rowIndex="4">
                                <Label fx:id="passwordError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <PasswordField fx:id="password"
                                               promptText="Password"
                                               maxWidth="Infinity"
                                               styleClass="register-field"/>
                            </VBox>

                            <!-- Confirm password -->
                            <VBox spacing="3"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="4">
                                <Label fx:id="confirmPasswordError"
                                       styleClass="field-error"
                                       visible="false" managed="false"
                                       wrapText="true"/>
                                <PasswordField fx:id="confirmPassword"
                                               promptText="Confirm Password"
                                               maxWidth="Infinity"
                                               styleClass="register-field"/>
                            </VBox>

                        </GridPane>

                        <Button fx:id="registerButton"
                                text="Register"
                                maxWidth="Infinity"
                                styleClass="register-button"
                                onAction="#handleRegister"/>

                        <Label fx:id="message"
                               wrapText="true"
                               styleClass="register-message"/>

                        <HBox alignment="CENTER" spacing="5">
                            <Label text="Already have an account?"
                                   style="-fx-text-fill: #102443; -fx-font-size: 13px;"/>
                            <Button text="Login"
                                    styleClass="register-link"
                                    onAction="#openLogin"/>
                        </HBox>

                    </VBox>

                </VBox>
            </content>

        </ScrollPane>

    </children>
</StackPane>
